# Copy this file to .env and fill in real values. .env is gitignored.

ENVIRONMENT=local
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000
# Where the Streamlit UI reaches the API — update when hosting them on different domains.
UI_API_BASE_URL=http://localhost:8000

POSTGRES_DSN=postgresql+psycopg://regintel:regintel@localhost:5432/regintel
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=regintel_chunks

# Free tier at console.groq.com — required once the LLM layer lands in Phase 4.
# Dense/sparse embeddings need no key at all (local fastembed models).
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Free tier at comet.com/opik. Tracing is fully disabled (no network calls at all)
# when this is unset, not just "logged out" — safe to leave blank.
OPIK_API_KEY=
OPIK_WORKSPACE=default
OPIK_PROJECT_NAME=regintel-ai

# Generate a real secret for anything beyond local dev: openssl rand -hex 32
# (must be >=32 bytes for HS256 per RFC 7518 3.2 — the default below is a
# placeholder sized to satisfy that, not a real secret)
JWT_SECRET=change-me-in-production-this-default-is-not-a-real-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
