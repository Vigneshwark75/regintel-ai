# Copy this file to .env and fill in real values. .env is gitignored.

ENVIRONMENT=local
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000

POSTGRES_DSN=postgresql+psycopg://regintel:regintel@localhost:5432/regintel
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=regintel_chunks

# At least one provider key is required once the LLM layer lands in Phase 4.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=anthropic

# Generate a real secret for anything beyond local dev: openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
